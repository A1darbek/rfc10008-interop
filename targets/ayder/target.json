{
  "schema_version": "0.2",
  "id": "ayder-local",
  "name": "Ayder",
  "implementation_url": "https://github.com/A1darbek/ayder",
  "implementation_commit": "2ddb6e346194c445445b04a4ffa5d1f9f700eaf2",
  "endpoint": "http://localhost:1109/broker/query",
  "method": "QUERY",
  "headers": {
    "Authorization": "Bearer dev",
    "Content-Type": "application/json"
  },
  "request_body_file": "targets/ayder/request.json",
  "equivalent_request_body_file": "targets/ayder/request-equivalent.json",
  "capabilities": {
    "accept_query": true,
    "etag": true,
    "conditional_revalidation": true,
    "content_location": false,
    "method_override": false,
    "semantic_query_identity": true,
    "cors_preflight": false,
    "cache_observability": false,
    "implementation_safety_receipt": true
  },
  "expectations": {
    "native_query_status": 200,
    "supported_content_type_status": 200,
    "unsupported_content_type_status": 415,
    "missing_content_type_mode": "observe"
  },
  "setup": {
    "kind": "ayder_payment_recovery",
    "topic": "payment-recovery",
    "group": "payment-worker"
  }
}
