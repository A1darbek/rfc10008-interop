{
  "schema_version": "0.2",
  "id": "laravel13-query-comparison",
  "name": "Laravel 13 QUERY comparison",
  "implementation_url": "https://github.com/phoenix1331/laravel-http-query-demo",
  "implementation_commit": "af19ed98eb77b62f5156ce285dc2ea135788519a",
  "endpoint": "http://localhost:8080/mock/orders",
  "method": "QUERY",
  "headers": {
    "Content-Type": "application/json",
    "Accept": "application/json"
  },
  "request_body_file": "targets/laravel13-query-comparison/request.json",
  "equivalent_request_body_file": "targets/laravel13-query-comparison/request-equivalent.json",
  "capabilities": {
    "accept_query": false,
    "etag": false,
    "conditional_revalidation": false,
    "content_location": false,
    "semantic_query_identity": false,
    "method_override": false,
    "cors_preflight": true,
    "cache_observability": false,
    "implementation_safety_receipt": false
  },
  "expectations": {
    "native_query_status": 200,
    "supported_content_type_status": 200,
    "unsupported_content_type_mode": "observe",
    "missing_content_type_mode": "observe"
  }
}
