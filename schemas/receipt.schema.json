{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "runner",
    "target",
    "environment",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "runner": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "environment": {
      "type": "object"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_SUPPORTED",
              "NOT_APPLICABLE",
              "UNVERIFIED",
              "OBSERVED"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
